// Середовище — окремий вимір від Debug/Release: схема Poruch-Dev (Debug-Dev / Release-Dev)
// ходить у dev-проєкт Supabase, Poruch-Prod (Debug-Prod / Release-Prod) — у prod.
// Адреси й ключі живуть у shared AppEnvironment, тут лише вибір.
APP_ENV[config=*-Dev] = DEV
APP_ENV[config=*-Prod] = PROD
APP_DISPLAY_NAME[config=*-Dev] = Поряд Dev
APP_DISPLAY_NAME[config=*-Prod] = Поряд
// Dev — окремий застосунок поруч із prod: свій bundle id, свій Firebase (Firebase/<env>/) і своя
// схема auth-колбеку (та сама, що poriad.*.authScheme у gradle.properties).
PRODUCT_BUNDLE_IDENTIFIER[config=*-Dev] = app.poriad.ios.dev
PRODUCT_BUNDLE_IDENTIFIER[config=*-Prod] = app.poriad.ios
APP_AUTH_SCHEME[config=*-Dev] = poriad-dev
APP_AUTH_SCHEME[config=*-Prod] = poriad
APP_FIREBASE_DIR[config=*-Dev] = dev
APP_FIREBASE_DIR[config=*-Prod] = prod
MAP_TILES_URL = https:/$()/tiles.openfreemap.org/planet
MAP_GLYPHS_URL = https:/$()/tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
