*.p8
*.p12
*.pem
*service-account*.json
.dev.vars
.claude/settings.local.json

# Журнал tools/apply_sql.py: локальний стан застосованих дампів
.applied_sql.json
# Робочі теки tools/apply_sql.py run: живуть до успішного застосування
out/

# Ключ підпису релізу: лише локально
*.jks
*.keystore
keystore.properties

# graphify knowledge graph output
graphify-out/
.ua/

# Android Studio / IntelliJ
.idea/

# Claude Design upload (built by .design-sync/build.py)
ds-bundle/

