  <!-- Прокат виставки чи ярмарку: «триває зараз» на ньому не каже, до коли ще можна, а дата
       початку читається як минуле. %1$s — дата кінця, «30 вересня». -->
  <string name="underway_until">до %1$s</string>
  <!-- Решта сеансів прокату на картці. Число, а не проміжок «22–30 грудня»: прокат буває з
       розривами («Хор Гомін» 5, 12 і 27 жовтня), і проміжок збрехав би про дні між ними. -->
  <plurals name="series_more_dates">
    <item quantity="one">ще %d дата</item>
    <item quantity="few">ще %d дати</item>
    <item quantity="many">ще %d дат</item>
    <item quantity="other">ще %d дати</item>
  </plurals>
  <!-- Кілька сеансів того самого дня: «ще 1 дата» про них збрехало б. -->
  <plurals name="series_more_showings">
    <item quantity="one">ще %d сеанс</item>
    <item quantity="few">ще %d сеанси</item>
    <item quantity="many">ще %d сеансів</item>
    <item quantity="other">ще %d сеансу</item>
  </plurals>
